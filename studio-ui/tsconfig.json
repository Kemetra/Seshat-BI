{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // `node` is here for `vitest.config.ts` ONLY, which reads tokens.css off disk to
    // inline it for the contrast audit -- a config file already runs on Node. Application
    // and test code must stay browser-shaped: `src/` importing `node:*` would break the
    // FR-005 promise that end users need no Node runtime, and that direction is pinned by
    // `test_studio_frontend_build.py` plus the wheel-content tests rather than by types.
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
